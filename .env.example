CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=dev_password
CLICKHOUSE_DB=raw
CLICKHOUSE_SCHEMA=raw

# Airflow: iguala el uid del contenedor al del host para que dbt pueda escribir
# target/logs en ./housing montado por bind mount. `echo "AIRFLOW_UID=$(id -u)" >> .env`
AIRFLOW_UID=50000
